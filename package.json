    "playwright": "^1.56.1",
    "script-loader": "^0.7.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.6",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "yargs": "^17.6.2"
