{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "draw2d": ["types/index.d.ts"],
      "draw2d/core": ["types/core/index.d.ts"],
      "draw2d/core/*": ["types/core/*"],
      "draw2d/shape": ["types/shape/index.d.ts"],
      "draw2d/shape/*": ["types/shape/*"],
      "draw2d/geo": ["types/geo/index.d.ts"],
      "draw2d/geo/*": ["types/geo/*"],
      "draw2d/policy": ["types/policy/index.d.ts"],
      "draw2d/policy/*": ["types/policy/*"],
      "draw2d/layout": ["types/layout/index.d.ts"],
      "draw2d/layout/*": ["types/layout/*"],
      "draw2d/command": ["types/command/index.d.ts"],
      "draw2d/command/*": ["types/command/*"],
      "draw2d/io": ["types/io/index.d.ts"],
      "draw2d/io/*": ["types/io/*"],
      "draw2d/util": ["types/util/index.d.ts"],
      "draw2d/util/*": ["types/util/*"],
      "draw2d/ui": ["types/ui/index.d.ts"],
      "draw2d/ui/*": ["types/ui/*"],
      "draw2d/decoration": ["types/decoration/index.d.ts"],
      "draw2d/decoration/*": ["types/decoration/*"]
    }
  },
  "include": ["test.ts"],
  "exclude": []
}